	local Expression = Calculator.Text

	if not Expression:match("^[%d%s%+%-%*/%.%(%)]+$") then
		Result.Text = "Resultado: inválido"
		return
	end

	local Function = loadstring("return "..Expression)

	if not Function then
		Result.Text = "Resultado: erro"
		return
	end

	local Success,Value = pcall(Function)

	if Success then
		Result.Text = "Resultado: "..tostring(Value)
	else
		Result.Text = "Resultado: erro"
	end
end)

