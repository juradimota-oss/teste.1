local function Toggle(Page,Name,Default,Callback)

	local Value = Default

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1,-20,0,43)
	Button.BackgroundColor3 = Color3.fromRGB(31,31,41)
	Button.TextColor3 = Color3.new(1,1,1)
	Button.Font = Enum.Font.GothamBold
	Button.TextSize = 14
	Button.Parent = Page

	Instance.new("UICorner",Button).CornerRadius = UDim.new(0,8)

	local function Update()

		Button.Text = Name.." : "..(Value and "ON" or "OFF")

		if Value then
			Button.BackgroundColor3 = Color3.fromRGB(50,50,65)
		else
			Button.BackgroundColor3 = Color3.fromRGB(31,31,41)
		end
	end

	Update()

	Button.MouseButton1Click:Connect(function()

		Value = not Value
		Update()

		Callback(Value)
	end)
end

local function Selector(Page,Name,Options,Callback)

	local Index = 1

	local Button = Instance.new("TextButton")
	Button.Size = UDim2.new(1,-20,0,43)
	Button.BackgroundColor3 = Color3.fromRGB(31,31,41)
	Button.TextColor3 = Color3.new(1,1,1)
	Button.Font = Enum.Font.GothamBold
	Button.TextSize = 14
	Button.Text = Name.." : "..Options[Index]
	Button.Parent = Page

	Instance.new("UICorner",Button).CornerRadius = UDim.new(0,8)

	Button.MouseButton1Click:Connect(function()

		Index += 1

		if Index > #Options then
			Index = 1
		end

		Button.Text = Name.." : "..Options[Index]

		Callback(Options[Index])
	end)
end

